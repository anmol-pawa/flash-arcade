{
  "name": "flash-arcade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "set CONTAINER_CONNECTION=flash-arcade-root&& podman-compose up -d",
    "db:down": "set CONTAINER_CONNECTION=flash-arcade-root&& podman-compose down",
    "db:logs": "set CONTAINER_CONNECTION=flash-arcade-root&& podman-compose logs -f"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "^0.4.1",
    "@tanstack/react-query": "^5.101.3",
    "next": "16.2.10",
    "pg": "^8.23.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
